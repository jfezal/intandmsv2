generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InstallationState {
  id              String   @id @default("default")
  bootstrapClosed Boolean  @default(false) @map("bootstrap_closed")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("installation_state")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  login            String   @unique @db.VarChar(128)
  displayName      String   @map("display_name") @db.VarChar(256)
  enabled          Boolean  @default(true)
  securityRevision Int      @default(0) @map("security_revision")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  passwordCredential PasswordCredential?
  sessions           Session[]
  userRoles          UserRole[]
  authEvents         AuthEvent[]

  @@map("users")
}

model PasswordCredential {
  userId              String   @id @map("user_id") @db.Uuid
  algorithm           String   @default("argon2id") @db.VarChar(32)
  passwordHash        String   @map("password_hash") @db.Text
  passwordChangedAt   DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  mustResetPassword   Boolean  @default(false) @map("must_reset_password")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenDigest      String    @unique @map("token_digest") @db.VarChar(128)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  securityRevision Int       @map("security_revision")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(64)
  displayName String   @map("display_name") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(128)
  description String   @db.VarChar(256)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuthEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  login     String?  @db.VarChar(128)
  outcome   String   @db.VarChar(32)
  reason    String?  @db.VarChar(64)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("auth_events")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.VarChar(64)
  eventType     String    @map("event_type") @db.VarChar(128)
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(6)

  @@index([dispatchedAt, createdAt])
  @@map("outbox_events")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(128)
  targetType   String?  @map("target_type") @db.VarChar(64)
  targetId     String?  @map("target_id") @db.VarChar(64)
  outcome      String   @db.VarChar(32)
  requestId    String?  @map("request_id") @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_events")
}

enum RepositoryType {
  MANAGED
  INDEXED
}

enum RepositoryStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

model StorageConnection {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(128)
  provider  String   @db.VarChar(32)
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  repositories Repository[]

  @@map("storage_connections")
}

model Repository {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String           @db.VarChar(256)
  description         String?          @db.Text
  type                RepositoryType
  status              RepositoryStatus @default(ACTIVE)
  storageConnectionId String           @map("storage_connection_id") @db.Uuid
  rootRelativePath    String           @map("root_relative_path") @db.VarChar(512)
  revision            Int              @default(0)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  storageConnection StorageConnection @relation(fields: [storageConnectionId], references: [id])
  folders           Folder[]
  documents         Document[]

  @@map("repositories")
}

model Folder {
  id             String   @id @default(uuid()) @db.Uuid
  repositoryId   String   @map("repository_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String   @db.VarChar(256)
  relativePath   String   @map("relative_path") @db.VarChar(1024)
  revision       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  parent     Folder?    @relation("FolderTree", fields: [parentId], references: [id])
  children   Folder[]   @relation("FolderTree")
  documents  Document[]

  @@unique([repositoryId, relativePath])
  @@index([repositoryId, parentId])
  @@map("folders")
}

model Document {
  id               String   @id @default(uuid()) @db.Uuid
  repositoryId     String   @map("repository_id") @db.Uuid
  folderId         String?  @map("folder_id") @db.Uuid
  displayName      String   @map("display_name") @db.VarChar(512)
  lifecycleState   String   @default("active") @map("lifecycle_state") @db.VarChar(32)
  currentVersionId String?  @unique @map("current_version_id") @db.Uuid
  revision         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  repository     Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  folder         Folder?           @relation(fields: [folderId], references: [id])
  versions       DocumentVersion[] @relation("DocumentVersions")
  currentVersion DocumentVersion?  @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id])

  @@index([repositoryId, folderId])
  @@map("documents")
}

model StorageObject {
  id         String   @id @default(uuid()) @db.Uuid
  storageKey String   @unique @map("storage_key") @db.VarChar(1024)
  sha256     String   @db.VarChar(64)
  sizeBytes  BigInt   @map("size_bytes")
  mimeType   String   @map("mime_type") @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  versions DocumentVersion[]

  @@map("storage_objects")
}

model DocumentVersion {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  sequence        Int
  sha256          String   @db.VarChar(64)
  sizeBytes       BigInt   @map("size_bytes")
  mimeType        String   @map("mime_type") @db.VarChar(128)
  storageObjectId String   @map("storage_object_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  description     String?  @db.VarChar(512)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document      Document      @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor    Document?     @relation("CurrentDocumentVersion")
  storageObject StorageObject @relation(fields: [storageObjectId], references: [id])
  searchChunks  SearchChunk[]

  @@unique([documentId, sequence])
  @@map("document_versions")
}

model SearchChunk {
  id                String @id @default(uuid()) @db.Uuid
  documentVersionId String @map("document_version_id") @db.Uuid
  chunkIndex        Int    @map("chunk_index")
  textContent       String @map("text_content") @db.Text

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([documentVersionId, chunkIndex])
  @@index([documentVersionId])
  @@map("search_chunks")
}

model IndexedConnector {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(256)
  protocol       String           @db.VarChar(16)
  host           String           @db.VarChar(256)
  exportPath     String           @map("export_path") @db.VarChar(512)
  readOnly       Boolean          @default(true) @map("read_only")
  status         RepositoryStatus @default(ACTIVE)
  lastHealthAt   DateTime?        @map("last_health_at") @db.Timestamptz(6)
  lastHealthNote String?          @map("last_health_note") @db.VarChar(512)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("indexed_connectors")
}

model WorkflowDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(64)
  name      String   @db.VarChar(256)
  version   Int      @default(1)
  definition Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("workflow_definitions")
}

model RetentionPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(256)
  rule        Json
  reportOnly  Boolean  @default(true) @map("report_only")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("retention_policies")
}
