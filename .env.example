# Copy to .env at repo root for local development.
NODE_ENV=development

DATABASE_URL=postgresql://intandms:intandms_dev_only@127.0.0.1:5436/intandms
MIGRATION_DATABASE_URL=postgresql://intandms:intandms_dev_only@127.0.0.1:5436/intandms

VALKEY_URL=redis://127.0.0.1:6380

API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=http://127.0.0.1:3000

WEB_ORIGIN=http://127.0.0.1:5173
# LAN testers open http://<this-host-ip>:5173 (Vite binds all interfaces). Keep WEB_ORIGIN
# as 127.0.0.1 while the browser uses the Vite proxy; do not point testers at :3000.
SESSION_COOKIE_NAME=intandms_session
SESSION_IDLE_SECONDS=3600
SESSION_ABSOLUTE_SECONDS=28800

# Generate for production: openssl rand -base64 32
SESSION_SIGNING_SECRET=change-me-use-openssl-rand-base64-32

TRUST_PROXY=false

MANAGED_STORAGE_ROOT=./data/managed

# Optional lockdown for local indexed folders (comma separated). If unset, an administrator
# picks any readable folder on this server from the DMS UI.
# INDEXED_LOCAL_ROOTS=./data/indexed,/srv/shares

# ClamAV: install clamscan on host; set REQUIRE_CLAMAV=true in production
CLAMAV_DISABLED=true
REQUIRE_CLAMAV=false

# OCR last — enable when tesseract + lang packs installed
OCR_ENABLED=false

# LibreOffice headless previews for Office formats (DOCX/XLSX/PPTX)
LIBREOFFICE_DISABLED=false
LIBREOFFICE_BIN=libreoffice
LIBREOFFICE_TIMEOUT_MS=120000

# Playwright two-user tests (`npm run test:e2e`). Do not commit real passwords.
# E2E_ADMIN_LOGIN=admin
# E2E_ADMIN_PASSWORD=
# E2E_STAFF_LOGIN=pegawai1
# E2E_STAFF_PASSWORD=

# Connector gateway (local host agent for SMB test/mount)
CONNECTOR_GATEWAY_URL=http://127.0.0.1:3099
CONNECTOR_GATEWAY_TOKEN=change-me-gateway-token
# On gateway process only:
# CONNECTOR_GATEWAY_HOST=127.0.0.1
# CONNECTOR_GATEWAY_PORT=3099
# CONNECTOR_ALLOW_CIFS_MOUNT=false
